# Entrada
ARCHIVO_CSV=cuentas.csv
COLUMNA_ID=id_cuenta

# API
API_URL_BASE=https://jsonplaceholder.typicode.com/posts
API_TIMEOUT_SEGUNDOS=10

# Reintentos (espera = ESPERA_INICIAL * FACTOR ^ intento)
REINTENTOS_MAXIMO=4
REINTENTOS_ESPERA_INICIAL_SEGUNDOS=1
REINTENTOS_FACTOR=2

# Salida
ARCHIVO_EXCEL=salida/resultado.xlsx
ARCHIVO_ESTADO=salida/estado.db

# Logs
ARCHIVO_LOG=logs/proceso.log
NIVEL_LOG=INFO
